# Autonomous Revenue Agent — configuration
#
#   cp .env.example .env
#
# No variable is mandatory: with no key, every integration falls back to a simulated adapter
# and the system runs end to end. `revenue-agent status` shows at any moment what is really
# wired up and what is simulated.

# ─────────────────────────────────────────────────────────────────────────────
# Autonomy limits — read this before anything else
# ─────────────────────────────────────────────────────────────────────────────

# supervised : the agent drafts, nothing goes out without human approval  (default)
# autonomous : the agent acts on its own, except for what the policy holds back
# dry_run    : nothing goes out, not even once approved
AGENT_MODE=supervised

# Above this opportunity amount, every outbound action requires approval.
MAX_AUTONOMOUS_AMOUNT=50000

# Maximum number of messages per prospect over 24h. Beyond that, the send is blocked.
MAX_OUTBOUND_PER_DAY=3

# Allow-list of recipients, comma-separated. Empty = no restriction.
# FILL THIS IN FOR A DEMO: this is what prevents a real prospect from being contacted by mistake.
ALLOWED_RECIPIENTS=

# ─────────────────────────────────────────────────────────────────────────────
# Model — OpenRouter (with no key: no decisions, events are merely recorded)
# ─────────────────────────────────────────────────────────────────────────────

OPENROUTER_API_KEY=
# Routine decisions, and review of outbound messages.
MODEL_ROUTINE=openai/gpt-5.6-luna
# High-stakes decisions: large amount, late stage, unresolved objection.
MODEL_STRATEGIC=openai/gpt-5.6-sol

# ─────────────────────────────────────────────────────────────────────────────
# CRM — HubSpot (with no token: local JSON memory under var/)
# ─────────────────────────────────────────────────────────────────────────────

# Free developer account on developers.hubspot.com, then inside the test account:
# Settings > Integrations > Private Apps. Required scopes:
#   crm.objects.deals.read, crm.objects.deals.write,
#   crm.objects.contacts.read, crm.objects.companies.read,
#   crm.objects.notes.write, crm.objects.calls.write
HUBSPOT_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Channels (with no key: sends are simulated to the console)
# ─────────────────────────────────────────────────────────────────────────────

RESEND_API_KEY=
RESEND_FROM_ADDRESS=agent@resend.dev

# WhatsApp Cloud API, developer test mode: free, 5 declared recipient numbers.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# A string of your choosing, to be copied verbatim into the Meta webhook configuration.
WHATSAPP_VERIFY_TOKEN=

# Outbound phone calls. All three variables are needed together.
RETELL_API_KEY=
RETELL_FROM_NUMBER=
RETELL_AGENT_ID=
# Verifies the signature of Retell webhooks. Left empty, webhooks are accepted without
# verification — acceptable locally, never on a public URL.
RETELL_WEBHOOK_SECRET=

# Web enrichment of the prospect's context. $20 of credits on sign-up, no card.
EXA_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Handoff — where the agent reaches a human
# ─────────────────────────────────────────────────────────────────────────────
#
# Without any of these variables, handoffs and approval requests reach nobody outside the
# logs. `revenue-agent status` flags this explicitly.
#
# HubSpot (if HUBSPOT_TOKEN is set): a task is created on the deal, assigned to its owner.
# The most native destination — the sales rep finds it where they already work.
# Fallback owner when the deal declares none (numeric HubSpot identifier):
HUBSPOT_OWNER_ID=

# Teams: URL of a Power Automate workflow "When a Teams webhook request is received".
# No app registration, no admin consent — just a URL.
TEAMS_WEBHOOK_URL=

# WhatsApp: colleagues' numbers, comma-separated, international format. Reuses the Meta
# connection already configured above for prospects — only the recipient changes. Lands in a
# pocket rather than in a tool someone has to open, which for an approval that needs an answer
# within the hour is often the only channel that gets a reply.
# Note: these notifications deliberately bypass the outbound policy. A rate cap meant to stop
# the agent hounding a prospect must never stop it warning a colleague.
HANDOFF_WHATSAPP_NUMBERS=

# Public URL of this API (ngrok tunnel for a demo). Used to build the arbitration link
# slipped into notifications: without it, the recipient is informed but cannot act.
PUBLIC_BASE_URL=

# Protects the arbitration page and routes, which trigger real sends. The token travels as a
# URL parameter so that a link received in Teams is clickable from a phone — an accepted
# trade-off for an internal tool, to be replaced by real authentication if the tool sticks
# around. Left empty, the arbitration routes are OPEN.
APPROVAL_UI_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Periodic scan
# ─────────────────────────────────────────────────────────────────────────────

# Protects POST /scan, which consumes LLM tokens. Set it as soon as the API is exposed
# publicly (ngrok), and copy it into the Trigger.dev environment variables.
SCAN_SHARED_SECRET=

# Overlap window: the HubSpot search index is eventually consistent, so we re-read a little
# before the last pointer in order not to miss a lead.
SCAN_OVERLAP_MINUTES=5

# An opportunity with no action for this many days is woken up by the scan.
SCAN_INACTIVITY_DAYS=14

# Cap on decision cycles per scan — bounds the LLM cost of one tick. The surplus is deferred
# to the next scan, never lost.
SCAN_MAX_DECISIONS=5

SCAN_PAGE_SIZE=100

# ─────────────────────────────────────────────────────────────────────────────
# Miscellaneous
# ─────────────────────────────────────────────────────────────────────────────

COMPANY_NAME=Notre Entreprise

# The agent's execution state. The local CRM, catalogue and approval queue files are created
# in the same directory.
STATE_FILE=var/state.json

LOG_LEVEL=INFO
# LOG_FORMAT=json   # uncomment when logs are aggregated (container, Trigger.dev)
