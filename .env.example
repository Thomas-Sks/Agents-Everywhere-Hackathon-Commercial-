# Autonomous Revenue Agent — configuration
#
#   cp .env.example .env
#
# Aucune variable n'est obligatoire : sans clé, chaque intégration bascule sur un adapter
# simulé et le système tourne de bout en bout. `revenue-agent status` affiche à tout moment
# ce qui est réellement branché et ce qui est simulé.

# ─────────────────────────────────────────────────────────────────────────────
# Limites d'autonomie — à lire avant tout le reste
# ─────────────────────────────────────────────────────────────────────────────

# supervised : l'agent rédige, rien ne part sans validation humaine  (défaut)
# autonomous : l'agent agit seul, sauf ce que la politique retient
# dry_run    : rien ne sort, même approuvé
AGENT_MODE=supervised

# Au-delà de ce montant d'opportunité, toute action sortante exige une validation.
MAX_AUTONOMOUS_AMOUNT=50000

# Nombre maximal de messages par prospect sur 24 h. Au-delà, l'envoi est bloqué.
MAX_OUTBOUND_PER_DAY=3

# Liste blanche de destinataires, séparés par des virgules. Vide = aucune restriction.
# À RENSEIGNER EN DÉMO : c'est ce qui empêche un vrai prospect d'être contacté par erreur.
ALLOWED_RECIPIENTS=

# ─────────────────────────────────────────────────────────────────────────────
# Modèle — OpenRouter (sans clé : aucune décision, les événements sont seulement consignés)
# ─────────────────────────────────────────────────────────────────────────────

OPENROUTER_API_KEY=
# Décisions de routine, et relecture des messages sortants.
MODEL_ROUTINE=openai/gpt-5.6-luna
# Décisions à enjeu : gros montant, stade tardif, objection non résolue.
MODEL_STRATEGIC=openai/gpt-5.6-sol

# ─────────────────────────────────────────────────────────────────────────────
# CRM — HubSpot (sans token : mémoire JSON locale dans var/)
# ─────────────────────────────────────────────────────────────────────────────

# Compte développeur gratuit sur developers.hubspot.com, puis dans le compte de test :
# Settings > Integrations > Private Apps. Scopes nécessaires :
#   crm.objects.deals.read, crm.objects.deals.write,
#   crm.objects.contacts.read, crm.objects.companies.read,
#   crm.objects.notes.write, crm.objects.calls.write
HUBSPOT_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Canaux (sans clé : envois simulés en console)
# ─────────────────────────────────────────────────────────────────────────────

RESEND_API_KEY=
RESEND_FROM_ADDRESS=agent@resend.dev

# WhatsApp Cloud API, mode test développeur : gratuit, 5 numéros destinataires déclarés.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Chaîne de votre choix, à recopier à l'identique dans la configuration du webhook Meta.
WHATSAPP_VERIFY_TOKEN=

# Appels téléphoniques sortants. Les trois variables sont nécessaires ensemble.
RETELL_API_KEY=
RETELL_FROM_NUMBER=
RETELL_AGENT_ID=
# Vérifie la signature des webhooks Retell. Laissé vide, les webhooks sont acceptés sans
# vérification — acceptable en local, jamais sur une URL publique.
RETELL_WEBHOOK_SECRET=

# Enrichissement web du contexte prospect. 20 $ de crédits à l'inscription, sans carte.
EXA_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Scan périodique
# ─────────────────────────────────────────────────────────────────────────────

# Protège POST /scan, qui consomme des tokens LLM. À renseigner dès que l'API est exposée
# publiquement (ngrok), et à recopier dans les variables d'environnement Trigger.dev.
SCAN_SHARED_SECRET=

# Fenêtre de recouvrement : l'index de recherche HubSpot est eventually consistent, on relit
# un peu avant le dernier pointeur pour ne pas rater de lead.
SCAN_OVERLAP_MINUTES=5

# Une opportunité sans action depuis ce nombre de jours est réveillée par le scan.
SCAN_INACTIVITY_DAYS=14

# Plafond de cycles de décision par scan — borne le coût LLM d'un tick. Le surplus est
# reporté au scan suivant, jamais perdu.
SCAN_MAX_DECISIONS=5

SCAN_PAGE_SIZE=100

# ─────────────────────────────────────────────────────────────────────────────
# Divers
# ─────────────────────────────────────────────────────────────────────────────

COMPANY_NAME=Notre Entreprise

# État d'exécution de l'agent. Les fichiers CRM local, catalogue et file de validation sont
# créés dans le même répertoire.
STATE_FILE=var/state.json

LOG_LEVEL=INFO
# LOG_FORMAT=json   # décommenter quand les logs sont agrégés (conteneur, Trigger.dev)
